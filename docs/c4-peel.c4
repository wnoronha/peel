C4Context
title Peel — system context
Person(user, "User", "runs peel against docs, browses, leaves notes, and pairs with agent")
System(peel, "Peel", "single Go binary: serve, render, collect feedback")
System_Ext(agent, "Coding agent", "monitors events, pairs with user, edits sources, acks notes")
System_Ext(root, "Docs root", "*.md, marp decks, *.c4 on disk")
Rel(user, peel, "starts CLI, browses and annotates")
Rel(user, agent, "pairs with")
Rel(peel, root, "reads and watches")
Rel(agent, peel, "GET feedback, POST ack")
Rel(agent, root, "edits markdown and c4")
---
C4Container
title Peel — containers
Person(user, "User", "browser & CLI")
Container(cli, "CLI", "flags, embed web, open browser")
Container(api, "HTTP API", "files, doc, feedback, SSE")
Container(watch, "Watcher", "fsnotify → SSE reload")
Container(web, "Web UI", "Alpine + pele + Lucide")
ContainerDb(log, "feedback.jsonl", "append-only note/ack/tombstone (API-managed only)")
Container_Ext(disk, "Docs root", "source of truth (*.md, *.c4)")
System_Ext(agent, "Coding agent", "interacts via HTTP API only; edits doc sources")
Rel(user, web, "uses")
Rel(user, cli, "starts")
Rel(web, api, "fetch / POST")
Rel(api, log, "append + fold (exclusive access)")
Rel(api, disk, "read markdown / c4")
Rel(watch, disk, "watches")
Rel(watch, web, "SSE reload")
Rel(cli, api, "starts server")
Rel(agent, api, "SSE events & POST ack (no feedback file access)")
Rel(agent, disk, "edits doc files directly")
---
C4Component
title Peel — web UI
Container(web, "Web UI", "Alpine app")
Component(shell, "Shell", "drawers, tabs, Goto Anything")
Component(reader, "Reader", "docs + deck slides")
Component(c4v, "C4 view", "levels, kinds, zoom, drill")
Component(annotate, "Annotate", "selection, chips, composer")
Component(feedback, "Feedback drawer", "open / acked / dismissed")
Rel(shell, reader, "hosts")
Rel(shell, c4v, "hosts")
Rel(shell, feedback, "hosts")
Rel(reader, annotate, "quotes into")
Rel(c4v, annotate, "quotes into")
Rel(annotate, feedback, "new open notes")
---
C4Component
title Peel — Go server
Container(server, "Go server", "embeds web, serves API")
Component(router, "HTTP Router", "serves static web, /api, and /events")
Component(renderer, "Doc Renderer", "Goldmark markdown, wikilinks, outline")
Component(fstore, "Feedback Store", "append fsync, fold open set")
Component(ssehub, "SSE Hub", "client event subscriptions & broadcast")
Component(watcher, "File Watcher", "recursive fsnotify watcher")
ContainerDb(log, "feedback.jsonl", "append-only log")
Container_Ext(disk, "Docs root", "markdown and c4")
Rel(router, renderer, "renders /api/doc")
Rel(router, fstore, "handles /api/feedback")
Rel(router, ssehub, "streams /events")
Rel(watcher, ssehub, "broadcasts reload")
Rel(fstore, ssehub, "broadcasts feedback event")
Rel(fstore, log, "appends and reads")
Rel(renderer, disk, "reads doc sources")
Rel(watcher, disk, "watches tree")
---
C4Dynamic
title File change → live reload
System_Ext(agent, "User / Agent")
Container_Ext(disk, "Docs root")
Component(watcher, "File Watcher")
Component(ssehub, "SSE Hub")
Container(web, "Web UI")
Rel_U(agent, disk, "1 edits doc file (*.md / *.c4)")
Rel_U(disk, watcher, "2 emits fsnotify write")
Rel_U(watcher, ssehub, "3 dispatch reload message")
Rel_U(ssehub, web, "4 SSE push reload")
Rel_U(web, disk, "5 fetch /api/doc & re-render")
---
C4Dynamic
title Note → agent → ack
Person(user, "User")
Container(web, "Web UI")
Container(api, "HTTP API")
ContainerDb(log, "feedback.jsonl")
Container_Ext(disk, "Docs root")
System_Ext(agent, "Agent")
Rel_U(user, web, "1 select + save note")
Rel_U(web, api, "2 POST type=note")
Rel_U(api, log, "3 append note")
Rel_U(api, agent, "4 stream note via SSE (GET /events)")
Rel_U(agent, disk, "5 edit docs source on disk")
Rel_U(agent, api, "6 POST type=ack")
Rel_U(api, log, "7 append ack")
---
C4Code
title Feedback fold (conceptual)
Container(api, "HTTP API")
Component(post, "POST /api/feedback", "validate, id, append, fsync")
Component(get, "GET /api/feedback", "scan log, fold open set")
Component(fold, "Fold", "note − ack − tombstone")
Rel(post, fold, "writes events")
Rel(get, fold, "derives open / history")
