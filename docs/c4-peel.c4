C4Context
title Peel — system context
Person(user, "User", "starts peel, browses docs/decks/C4, leaves notes, pairs with an agent")
System(peel, "Peel", "one Go binary: embed UI, render markdown, fold feedback, SSE wake-ups")
System_Ext(agent, "Coding agent", "any tool that can HTTP + edit files; prefers skills/peel/peel_api.py")
System_Ext(root, "Docs root", "*.md, marp decks, *.c4 — source of truth on disk")
Rel(user, peel, "CLI + browser")
Rel(user, agent, "pairs / asks to monitor")
Rel(peel, root, "reads + watches; never rewrites .peel/ history")
Rel(agent, peel, "GET/POST feedback + GET /events")
Rel(agent, root, "edits markdown and .c4 sources")
---
C4Container
title Peel — containers
Person(user, "User", "browser and terminal")
Container(cli, "CLI", "main.go: --dir/--port/--host, go:embed web/*")
Container(api, "HTTP API", "/api/files, /api/doc, /api/feedback, /events, /healthz")
Container(watch, "Watcher", "recursive fsnotify on .md/.c4 → SSE reload")
Container(web, "Web UI", "Alpine peelApp, pele diagrams, Lucide, toasts")
ContainerDb(log, "feedback.jsonl", "append-only note/ack/tombstone under .peel/")
Container_Ext(disk, "Docs root", "*.md / *.c4 content (git-tracked)")
Container_Ext(skill, "Agent skill", "skills/peel/peel_api.py + SKILL.md (portable)")
System_Ext(agent, "Coding agent", "Cursor, Claude, Codex, …")
Rel(user, cli, "starts")
Rel(user, web, "reads and annotates")
Rel(cli, api, "listens")
Rel(web, api, "fetch / POST / EventSource")
Rel(api, log, "append + fold (exclusive writer)")
Rel(api, disk, "render docs")
Rel(watch, disk, "watches tree")
Rel(watch, api, "broadcasts reload via SSE hub")
Rel(agent, skill, "follows")
Rel(skill, api, "health, open, wait-note, ack, pair")
Rel(agent, disk, "patches sources")
---
C4Component
title Peel — web UI
Container(web, "Web UI", "single Alpine component in web/app.js")
Component(shell, "Shell", "nav, Files [,], Feedback ], Goto Ctrl/Cmd-P/K")
Component(reader, "Reader", "markdown docs + marp slides + outline")
Component(c4v, "C4 view", "levels, kinds, zoom; click=comment, dblclick=drill")
Component(composer, "Composer", "selection or C4 click → chips → compact Save")
Component(feedback, "Feedback drawer", "open / acked / dismissed / all + peach marks")
Component(toasts, "Toasts", "ack, dismiss, remote note, doc reload")
Rel(shell, reader, "hosts")
Rel(shell, c4v, "hosts")
Rel(shell, feedback, "hosts")
Rel(shell, toasts, "hosts")
Rel(reader, composer, "selection opens")
Rel(c4v, composer, "click opens")
Rel(composer, feedback, "POST note → open queue")
Rel(toasts, feedback, "click opens drawer")
---
C4Component
title Peel — Go server
Container(server, "Go server", "internal/server + embeds web/")
Component(router, "HTTP router", "static + /api + /events")
Component(renderer, "Doc renderer", "Goldmark, wikilinks, outline, deck/C4 split")
Component(fstore, "Feedback store", "validate, id/ts, append, fsync, fold")
Component(ssehub, "SSE hub", "per-client channels, : hb heartbeats")
Component(watcher, "File watcher", "recursive fsnotify, debounce")
Component(links, "Link graph", "wikilinks + local md/c4 backlinks")
ContainerDb(log, "feedback.jsonl", "durable event log")
Container_Ext(disk, "Docs root", "markdown and c4")
Rel(router, renderer, "/api/doc")
Rel(router, fstore, "/api/feedback")
Rel(router, ssehub, "/events")
Rel(renderer, links, "counts + resolve")
Rel(watcher, ssehub, "type=reload")
Rel(fstore, ssehub, "type=feedback")
Rel(fstore, log, "append + read")
Rel(renderer, disk, "read sources")
Rel(watcher, disk, "watch tree")
---
C4Dynamic
title File change → live reload
Person(user, "User / agent")
Container_Ext(disk, "Docs root")
Component(watcher, "File watcher")
Component(ssehub, "SSE hub")
Container(web, "Web UI")
Rel_U(user, disk, "1 edit *.md / *.c4")
Rel_U(disk, watcher, "2 fsnotify")
Rel_U(watcher, ssehub, "3 debounce + broadcast")
Rel_U(ssehub, web, "4 data: {type:reload,path}")
Rel_U(web, disk, "5 GET /api/doc + re-render + toast")
---
C4Dynamic
title Note → agent → ack
Person(user, "User")
Container(web, "Web UI")
Container(api, "HTTP API")
ContainerDb(log, "feedback.jsonl")
Container_Ext(disk, "Docs root")
Container_Ext(skill, "peel_api.py")
System_Ext(agent, "Agent")
Rel_U(user, web, "1 select/click + Save note")
Rel_U(web, api, "2 POST type=note (+ anchors)")
Rel_U(api, log, "3 append + fsync")
Rel_U(api, skill, "4 SSE type=feedback (or poll)")
Rel_U(skill, agent, "5 stdout note JSON")
Rel_U(agent, disk, "6 edit sources")
Rel_U(agent, skill, "7 peel_api.py ack")
Rel_U(skill, api, "8 POST type=ack")
Rel_U(api, log, "9 append ack")
Rel_U(api, web, "10 SSE feedback → toast + Acked tab")
---
C4Code
title Feedback fold (conceptual)
Container(api, "HTTP API")
Component(post, "POST /api/feedback", "validate, mint id/ts, append, emit SSE")
Component(get, "GET /api/feedback", "all=1 raw log; default folded open")
Component(fold, "Fold", "open = note without later ack/tombstone for id")
Component(del, "DELETE /api/feedback", "append tombstone for open id")
Component(sanitize, "sanitizeC4ID", "letters digits _ - max 96")
Rel(post, fold, "writes events")
Rel(post, sanitize, "c4Id / from / to")
Rel(get, fold, "derives open set")
Rel(del, fold, "closes via tombstone")
