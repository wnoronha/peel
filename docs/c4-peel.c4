C4Context
title Peel — system context
Person(reader, "Reader", "reads docs, decks, C4; leaves notes")
Person(dev, "Operator", "runs peel against a docs folder")
System(peel, "Peel", "single Go binary: serve, render, collect feedback")
System_Ext(agent, "Coding agent", "reads JSONL / API; edits sources; acks")
System_Ext(root, "Docs root", "*.md, marp decks, *.c4 on disk")
Rel(reader, peel, "browses and annotates")
Rel(dev, peel, "starts CLI")
Rel(peel, root, "reads and watches")
Rel(agent, peel, "GET feedback, POST ack")
Rel(agent, root, "edits markdown and c4")
---
C4Container
title Peel — containers
Person(reader, "Reader", "browser")
Container(cli, "CLI", "flags, embed web, open browser")
Container(api, "HTTP API", "files, doc, feedback, SSE")
Container(watch, "Watcher", "fsnotify → SSE reload")
Container(web, "Web UI", "Alpine + pele + Lucide")
ContainerDb(log, "feedback.jsonl", "append-only note/ack/tombstone")
Container_Ext(disk, "Docs root", "source of truth")
Rel(reader, web, "uses")
Rel(web, api, "fetch / POST")
Rel(api, log, "append + fold")
Rel(api, disk, "read markdown / c4")
Rel(watch, disk, "watches")
Rel(watch, web, "SSE reload")
Rel(cli, api, "starts server")
---
C4Component
title Peel — web UI
Container(web, "Web UI", "Alpine app")
Component(shell, "Shell", "drawers, tabs, Goto Anything")
Component(reader, "Reader", "docs + deck slides")
Component(c4v, "C4 view", "levels, kinds, zoom, drill")
Component(annotate, "Annotate", "selection, chips, composer")
Component(feedback, "Feedback drawer", "open / acked / dismissed")
Rel(shell, reader, "hosts")
Rel(shell, c4v, "hosts")
Rel(shell, feedback, "hosts")
Rel(reader, annotate, "quotes into")
Rel(c4v, annotate, "quotes into")
Rel(annotate, feedback, "new open notes")
---
C4Dynamic
title Note → agent → ack
Person(reader, "Reader")
Container(web, "Web UI")
Container(api, "HTTP API")
ContainerDb(log, "feedback.jsonl")
System_Ext(agent, "Agent")
Rel_U(reader, web, "1 select + save note")
Rel_U(web, api, "2 POST type=note")
Rel_U(api, log, "3 append")
Rel_U(agent, log, "4 tail / GET fold")
Rel_U(agent, api, "5 POST type=ack")
Rel_U(api, log, "6 append ack")
---
C4Code
title Feedback fold (conceptual)
Container(api, "HTTP API")
Component(post, "POST /api/feedback", "validate, id, append, fsync")
Component(get, "GET /api/feedback", "scan log, fold open set")
Component(fold, "Fold", "note − ack − tombstone")
Rel(post, fold, "writes events")
Rel(get, fold, "derives open / history")
